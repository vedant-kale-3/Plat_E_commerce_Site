# Supabase
# Get these from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App
VITE_APP_NAME=Fiona
VITE_APP_URL=http://localhost:5173
